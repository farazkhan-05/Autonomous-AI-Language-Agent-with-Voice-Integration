{
  "displayName": "SpanishAmigo Auth Failures Spike",
  "documentation": {
    "content": "Authentication failures (401/403) are spiking for SpanishAmigo backend.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Auth failures over 15 per 5 minutes",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"__SERVICE_NAME__\" AND resource.labels.location=\"__REGION__\" AND metric.type=\"logging.googleapis.com/user/spanishamigo_auth_failures\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 15,
        "duration": "300s",
        "trigger": {
          "count": 1
        },
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_SUM"
          }
        ]
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "notificationChannels": [
    "__NOTIFICATION_CHANNEL__"
  ]
}
